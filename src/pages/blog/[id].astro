---
import IdHeader from "@/components/static/IdHeader.astro";
import IdLayout from "@/layouts/IdLayout.astro";
import { getCollection, render } from "astro:content";
import { parse } from "date-fns";
import "toc-rail/style.css";

export async function getStaticPaths() {
    const items = (await getCollection("blog")).filter((item) => !item.data.draft);
    return items.map((item) => ({
        params: { id: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);

const allItems = (await getCollection("blog"))
    .filter((item) => !item.data.draft)
    .sort((a, b) => {
        const dateA = parse(a.data.date, "dd-MM-yyyy", new Date());
        const dateB = parse(b.data.date, "dd-MM-yyyy", new Date());
        return dateA.getTime() - dateB.getTime();
    });

const currentIndex = allItems.findIndex((i) => i.id === item.id);
const prev = currentIndex > 0 ? allItems[currentIndex - 1] : null;
const next = currentIndex < allItems.length - 1 ? allItems[currentIndex + 1] : null;

const pubDate = parse(item.data.date, "dd-MM-yyyy", new Date());

// ── 窄屏静态目录 ──
// 宽屏由右侧阅读导轨接管（见文件末尾 @media 里的 display:none）
// 阈值与导轨脚本一致（h2/h3 ≥ 3 条），避免出现只有一条的“目录”
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showStaticToc = tocItems.length >= 3;
---

<IdLayout
    type="blog"
    title={item.data.title}
    description={item.data.description}
    image={`/og/blog/${item.id}.png`}
    pubDate={pubDate}
    author={item.data.author}
    tags={item.data.tags}
    prev={prev}
    next={next}
>
    <article transition:animate="fade">
        <IdHeader backUrl="/blog" items={item.data} compact />

        {showStaticToc && (
            <nav class="static-toc mt-5" aria-label="文章目录">
                <div class="static-toc__title">本页目录</div>
                <ol>
                    {tocItems.map((h) => (
                        <li class={`static-toc__item static-toc__item--h${h.depth}`}>
                            <a href={`#${h.slug}`}>{h.text}</a>
                        </li>
                    ))}
                </ol>
            </nav>
        )}
        <div class="mt-5 prose border border-border p-6">
            <Content />
        </div>
    </article>
</IdLayout>

{/* ── 文章右侧阅读导轨（toc-rail）：只覆盖 CSS 变量，不改库内部结构 ── */}
{/* 颜色基本沿用站点令牌（深浅色自动适配）；主色单独指定以保证 12px 小字的对比度 */}
<style is:global>
    .toc-rail {
        /* ① 主色：浅色深薄荷 #258062（白底 4.84:1 达 AA）；深色在下方 .dark 覆盖为亮薄荷 */
        --toc-rail-accent: #258062;
        --toc-rail-line: var(--border);
        --toc-rail-muted: var(--muted-foreground);
        --toc-rail-faint: var(--muted-foreground);
        --toc-rail-text: var(--foreground);
        --toc-rail-title: var(--muted-foreground);
        --toc-rail-width: 152px;
        /* 正文容器 max-w-4xl(896px) 居中 → 导轨贴其右缘留 20px */
        --toc-rail-left: calc(50vw + 448px + 1.25rem);
        --toc-rail-top: max(6.5rem, 22vh);
        --toc-rail-link-size: 0.75rem;
        --toc-rail-link-weight: 500;
        --toc-rail-link-line-height: 1.45;
        --toc-rail-font-family: inherit;
        --toc-rail-z-index: 10;
    }
    .dark .toc-rail {
        --toc-rail-accent: #58b798;
    }
    /* ③ 库用原生锚点跳转 → 给正文标题留出固定页头高度，点击后标题落在 y≈80px */
    .prose h2[id],
    .prose h3[id] {
        scroll-margin-top: 5rem;
    }
    /* ⑤ 窄屏（及不支持现代 JS 的浏览器）显示文章顶部静态目录；宽屏让位给右侧导轨 */
    /*    每条先写字面值再写 var()：旧内核取前者，现代浏览器取后者 */
    .static-toc {
        padding: 0.9rem 1.1rem;
        border-left: 3px solid #d4d4d8;
        border-left-color: var(--border);
        background: #fafafa;
        background: var(--card, #fafafa);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        line-height: 1.9;
    }
    .static-toc__title {
        margin-bottom: 0.4rem;
        font-weight: 600;
        color: #3f3f46;
        color: var(--foreground);
    }
    .static-toc ol {
        margin: 0;
        padding-left: 1.25rem;
        list-style: decimal;
    }
    .static-toc__item--h3 {
        margin-left: 0.9rem;
    }
    .static-toc a {
        color: #52525b;
        color: var(--muted-foreground);
        text-decoration: none;
    }
    .static-toc a:hover {
        color: #258062;
        text-decoration: underline;
    }
    .dark .static-toc {
        border-left-color: #3f3f46;
        border-left-color: var(--border);
        background: #27272a;
        background: var(--card, #27272a);
    }
    .dark .static-toc__title {
        color: #e4e4e7;
        color: var(--foreground);
    }
    .dark .static-toc a {
        color: #a1a1aa;
        color: var(--muted-foreground);
    }
    /* 宽屏：右侧导轨已接管（阈值与脚本里的 MIN_WIDTH 一致） */
    @media (min-width: 1280px) {
        .static-toc {
            display: none;
        }
    }
</style>

<script>
    import { mountTocRail, type TocRailInstance } from "toc-rail";

    const HEADINGS = ".prose h2[id], .prose h3[id]";
    // 标题太少（1–2 个）不显示，避免只剩一条目的“目录”
    const MIN_ITEMS = 3;
    // 必须与上面 --toc-rail-left 的算式匹配：正文 896 + 两侧留白 + 导轨 152
    const MIN_WIDTH = 1280;

    let rail: TocRailInstance | null = null;

    function tryMount() {
        if (rail) return;
        if (window.innerWidth < MIN_WIDTH) return;
        const content = document.querySelector(".prose");
        if (!content) return;
        if (content.querySelectorAll(HEADINGS).length < MIN_ITEMS) return;
        rail = mountTocRail({
            content: ".prose",
            headings: HEADINGS,
            title: false,
            ariaLabel: "文章目录",
            progressMode: "content",
            activeBoundary: "viewport-end",
            activeOffset: Math.round(window.innerHeight * 0.5),
            // ② hideBefore: false → 一进文章页就显示导轨（默认 true 会等正文进入视口才出现）
            edge: { hideBefore: false, afterBoundary: "viewport-end", afterOffset: 120 },
            minWidth: MIN_WIDTH,
            topOffset: 42,
        });
    }

    tryMount();
    window.addEventListener("resize", tryMount, { passive: true });

    // ④ 站内跳转（模板用了 ClientRouter/视图过渡）时，本模块不会重新求值，
    //    而旧 DOM 已被替换 → 必须先卸载旧的再重挂，否则导轨在跳转后消失。
    document.addEventListener("astro:page-load", () => {
        try {
            rail?.unmount();
        } catch {
            /* 旧实例可能已随 DOM 一起销毁，忽略 */
        }
        rail = null;
        tryMount();
    });
</script>
