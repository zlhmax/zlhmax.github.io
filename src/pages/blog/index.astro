---
import FilterBlog from "@/components/client/FilterBlog";
import IndexHeader from "@/components/static/IndexHeader.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { getSortedBlogPosts, getTotalPages, POSTS_PER_PAGE } from "@/lib/blogPaging";

// 第 1 页：全部文章排序后只切出前 6 篇（第 2 页起在 /blog/page/N/，见 src/pages/blog/page/[page].astro）
const allItems = await getSortedBlogPosts();
const totalPages = getTotalPages(allItems.length);
const pageItems = allItems.slice(0, POSTS_PER_PAGE);
---

<IndexLayout title="Blog - lhZhang" description="Thoughts on engineering, reliability, AI, and observation" image="/og/default.png">
    <div transition:animate="fade">
        <IndexHeader url="/" heading="Blog" subtitle="Thoughts I've had for a while"  icon="pen" />

        <div class="mt-3">
            <FilterBlog client:load items={pageItems} pageInfo={{ current: 1, total: totalPages }} />
        </div>
    </div>
</IndexLayout>
