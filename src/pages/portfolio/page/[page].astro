---
import FilterPortfolio from "@/components/client/FilterPortfolio";
import { getSortedPortfolioItems, getPortfolioTotalPages, PORTFOLIO_PER_PAGE } from "@/lib/portfolioPaging";
import { getImage } from "astro:assets";
import type { portfolioConfig } from "@/lib/types";
import type { ImageMetadata } from "astro";
import IndexHeader from "@/components/static/IndexHeader.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";

// Itinerary（Travel / portfolio）列表第 2 页起（第 1 页 = /portfolio/）：与 Blog 相同的静态分页做法，
// 构建期切片并生成 /portfolio/page/2/、/portfolio/page/3/ …（每页 8 条）
export async function getStaticPaths() {
  const allItems = getSortedPortfolioItems();
  const totalPages = getPortfolioTotalPages(allItems.length);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * PORTFOLIO_PER_PAGE;

    return {
      params: { page: String(currentPage) },
      props: {
        rawItems: allItems.slice(start, start + PORTFOLIO_PER_PAGE),
        currentPage,
        totalPages,
      },
    };
  });
}

type ImageRecord = { default: ImageMetadata };
const imageModules = import.meta.glob<ImageRecord>("@/assets/portfolio/*/*.{png,jpg,jpeg,webp,gif,avif}", { eager: true });

const { rawItems, currentPage, totalPages } = Astro.props;

const enriched = await Promise.all(
    rawItems.map(async (item) => {
        const matches = Object.entries(imageModules)
            .filter(([path]) => path.includes(`/assets/portfolio/${item.id}/`))
            .sort(([a], [b]) => a.localeCompare(b))
            .map(([, mod]) => mod.default);

        let heroImage: string | undefined;
        if (matches.length > 0) {
            const optimized = await getImage({ src: matches[0], width: 600 });
            heroImage = optimized.src;
        }

        return {
            ...item,
            ...item.data,
            keywords: item.data.tags,
            tagline: item.data.description,
            images: heroImage ? [heroImage] : [],
            heroImage,
        } as portfolioConfig & { heroImage?: string };
    }),
);
---

<IndexLayout
    title={`Itinerary - Page ${currentPage} - lhZhang`}
    description="精选旅拍与影像记录。Places I've been to and seen."
    image="/og/default.png"
>
    <div transition:animate="fade">
        <IndexHeader url="/" heading="Itinerary" subtitle="Places I've been to and seen" />

        <div class="mt-3">
            <FilterPortfolio client:load items={enriched} pageInfo={{ current: currentPage, total: totalPages }} />
        </div>
    </div>
</IndexLayout>
