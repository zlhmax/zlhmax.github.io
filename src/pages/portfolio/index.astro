---
import FilterPortfolio from "@/components/client/FilterPortfolio";
import { getSortedPortfolioItems, getPortfolioTotalPages, PORTFOLIO_PER_PAGE } from "@/lib/portfolioPaging";
import { getImage } from "astro:assets";
import type { portfolioConfig } from "@/lib/types";
import type { ImageMetadata } from "astro";
import IndexHeader from "@/components/static/IndexHeader.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";

// 第 1 页：按日期倒序后只切出前 8 条（第 2 页起在 /portfolio/page/N/）
const allItems = getSortedPortfolioItems();
const totalPages = getPortfolioTotalPages(allItems.length);
const pageItems = allItems.slice(0, PORTFOLIO_PER_PAGE);

type ImageRecord = { default: ImageMetadata };
const imageModules = import.meta.glob<ImageRecord>("@/assets/portfolio/*/*.{png,jpg,jpeg,webp,gif,avif}", { eager: true });

const enriched = await Promise.all(
    pageItems.map(async (item) => {
        const matches = Object.entries(imageModules)
            .filter(([path]) => path.includes(`/assets/portfolio/${item.id}/`))
            .sort(([a], [b]) => a.localeCompare(b))
            .map(([, mod]) => mod.default);

        let heroImage: string | undefined;
        if (matches.length > 0) {
            const optimized = await getImage({ src: matches[0], width: 600 });
            heroImage = optimized.src;
        }

        return {
            ...item,
            ...item.data,
            keywords: item.data.tags,
            tagline: item.data.description,
            images: heroImage ? [heroImage] : [],
            heroImage,
        } as portfolioConfig & { heroImage?: string };
    }),
);
---

<IndexLayout title="Itinerary - lhZhang" description="精选旅拍与影像记录。Places I've been to and seen." image="/og/default.png">
    <div transition:animate="fade">
        <IndexHeader url="/" heading="Itinerary" subtitle="Places I've been to and seen"  icon="camera" />

        <div class="mt-3">
            <FilterPortfolio client:load items={enriched} pageInfo={{ current: 1, total: totalPages }} />
        </div>
    </div>
</IndexLayout>
