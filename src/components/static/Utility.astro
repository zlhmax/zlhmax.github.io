---
import site_config from "@/site-config.json";
import ThemeToggle from "../client/ThemeToggle";
import { Button } from "../ui/button";
import { RiSearchLine } from "@remixicon/react";
---

<div class="flex gap-3">
    {
        site_config.bPageFind && (
            <>
                <Button variant="outline" size="icon-xs" className="search-trigger flex md:hidden border-transparent shadow-none text-muted-foreground/80 hover:text-link" aria-label="Search">
                    <RiSearchLine />
                </Button>
                <Button variant="outline" size="icon-xs" className="search-trigger hidden md:flex border-transparent shadow-none text-muted-foreground/80 hover:text-link" aria-label="Search (Ctrl+K)">
                    <RiSearchLine />
                </Button>
            </>
        )
    }
    {site_config.bThemeToggle && <ThemeToggle client:load />}
</div>
