---
import { buttonVariants } from "../ui/button";
import { RiArrowRightLine } from "@remixicon/react";
import site_config from "@/site-config.json";
import type { siteConfig } from "@/lib/types";
import { SocialIcon, SubHeadingIcon } from "@/lib/icons";

// 站名效果：一行（lh 保持浅黑，大写开头后半段 Zhang 用线性渐变）
const wmHeading = String(site_config.introduction.heading ?? "");
const wmSplit = wmHeading.match(/^([a-z]+)([A-Z][A-Za-z]*)$/);
const wmPlain = wmSplit ? wmSplit[1] : "";
const wmGrad = wmSplit ? wmSplit[2] : wmHeading;

// 【占位】头像（参考站为 72px 圆形）—— 待 Eddy 提供照片后替换 /avatar-placeholder.svg
const wmAvatar = "/avatar-placeholder.svg";


---


<section class="grid grid-cols-1 md:grid-cols-[61.8%_1fr] items-stretch bg-background border border-border overflow-hidden">
    {/* 左栏：黄金比 61.8%（文字与图标） */}
    <div class="min-w-0 px-6 pt-2 pb-2 flex flex-col justify-center">
        <div class="flex cursor-default gap-3 select-none">
            {
                site_config.introduction.badges &&
                    site_config.introduction.badges.map((badge) => (
                        <span class="rounded-sm border border-muted-foreground/30 px-2">
                            <span class="text-xs opacity-80">{badge}</span>
                        </span>
                    ))
            }
        </div>

        {/* 头部：站名/身份标签（原圆形羽毛笔已按要求移除）*/}
        <div class="flex items-center gap-4 select-none">
            <div class="flex flex-col min-w-0">
                <h1 class="text-[28px] opacity-90 intro-wordmark select-none" aria-label={wmHeading}>
                  <span class="wm-line"><svg class="wm-mark" viewBox="0 0 30 24" aria-hidden="true"><path class="wm-mark-track" d="M3 12h24" stroke="currentColor" stroke-opacity=".25" stroke-width="3" stroke-linecap="round" /><path class="wm-mark-accent" d="M3 12h15" stroke="var(--mark-accent)" stroke-width="3" stroke-linecap="round" /></svg>{wmPlain}{wmGrad && <span class="wm-grad">{wmGrad}</span>}</span>
                </h1>
                <div class="mt-1.5 flex flex-wrap items-center gap-3">
                    {
                        site_config.introduction.subHeadingItems &&
                            site_config.introduction.subHeadingItems.map((item) => (
                                <a href={item.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-sm text-muted-foreground/90 hover:text-link animation group w-fit">
                                    <SubHeadingIcon type={item.type as siteConfig["introduction"]["subHeadingItems"][number]["type"]} />
                                    <p class="cormorant-serif text-sm leading-relaxed">{item.label}</p>
                                </a>
                            ))
                    }
                </div>
            </div>
        </div>

        {
            site_config.introduction.description && (
                <p class="bio-type hand-note pt-1.5 pb-0"><span class="hand-arrow" aria-hidden="true">↳ </span>{site_config.introduction.description}</p>
            )
        }

        {/* 底行：位置 + 社交圆钮（照参考站合并到同一行）*/}
        <div class="mt-2 flex flex-wrap items-center gap-3">
            {
                site_config.introduction.socialItems &&
                    site_config.introduction.socialItems.map((item) => (
                        <a
                            href={item.url}
                            class="social-btn"
                            aria-label={item.type}
                            target={item.url.startsWith("http") ? "_blank" : undefined}
                            rel={item.url.startsWith("http") ? "noopener noreferrer" : undefined}
                        >
                            <SocialIcon type={item.type as siteConfig["introduction"]["socialItems"][number]["type"]} className="size-[0.85rem]" />
                        </a>
                    ))
            }
            {
                site_config.bRssFeed && (
                    <a href="/rss.xml" class="social-btn" aria-label="rss">
                        <SocialIcon type="rss" className="size-[0.85rem]" />
                    </a>
                )
            }
        </div>

        {
            (site_config.introduction.ctaItems || site_config.introduction.support) && (
                <div class="mt-4 flex gap-3">
                    {
                        site_config.introduction.ctaItems &&
                            site_config.introduction.ctaItems.map((cta) => (
                                <a href={cta.url} target="_blank" rel="noopener noreferrer" class={`${buttonVariants({ variant: cta.variant as siteConfig["introduction"]["ctaItems"][number]["variant"], size: "default" })} group`}>
                                    <span class="space-y-6 leading-relaxed opacity-90 text-xs translate-x-0.5">{cta.label}</span>
                                    <RiArrowRightLine className="size-0 group-hover:size-3.5 animation" />
                                </a>
                            ))
                    }
                    {
                        site_config.introduction.support && (
                            <a href={site_config.introduction.support.url} target="_blank" rel="noopener noreferrer" class={`${buttonVariants({ variant: site_config.introduction.support.variant as siteConfig["introduction"]["ctaItems"][number]["variant"], size: "default" })} group`}>
                                <div class="flex flex-col items-center justify-center pr-1 text-xs">
                                    <span class="scale-120 group-hover:scale-0 opacity-100 group-hover:opacity-0 translate-y-2.5 animation">☆</span>
                                    <span class="scale-0 group-hover:scale-120 opacity-0 group-hover:opacity-100 -translate-y-2.5 animation">★</span>
                                </div>
                                <span class="space-y-6 leading-relaxed opacity-90 text-xs">{site_config.introduction.support.label}</span>
                            </a>
                        )
                    }
                </div>
            )
        }
    </div>

    {/* 右栏：黄金比 38.2%（图片四周留 6px、四角 6px 圆角） */}
    <div class="relative min-h-[120px] overflow-hidden">
        {/* 绝对定位：图片不再用固有比例撑高整行，卡高由左栏内容决定 */}
        <div class="absolute inset-0 p-1.5">
            <img
                src="/images/home/intro-welcome.webp"
                alt=""
                width="1200"
                height="600"
                loading="eager"
                decoding="async"
                class="h-full w-full rounded-[6px] object-cover"
            />
        </div>
    </div>
</section>

