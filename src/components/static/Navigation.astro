---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import site_config from "@/site-config.json";

const { pathname } = Astro.props;
const isCurrent = (href: string) => pathname === href;

// 导航显示名可用 navigationLabels 覆盖（键 = 路由名，值 = 显示文案），路由地址本身不变
const labels = (site_config.navigationLabels ?? {}) as Record<string, string>;
const labelOf = (item: string) => labels[item] ?? item;
---

{
  site_config.bNavigation && (
    <>
      <Breadcrumb className="select-none nav-breadcrumb">
        {/* 字号/字重/字距/大写对齐参考站；变体1&2 压掉 BreadcrumbPage 自带的 font-normal 与 text-foreground/90，
            让「当前页（无链接）」与「有链接项」颜色一致；变体3 起 = 超链悬停下划线：
              常态画一条透明波浪线（decoration-transparent，不占布局）→ 悬停显色 hover:decoration-current，
              配 transition-[color,text-decoration-color] 得到淡入；离字 4px(underline-offset-4)、线宽 2px(decoration-2) */}
        <BreadcrumbList className="text-[0.72rem] font-bold tracking-[0.16em] uppercase [&_[data-slot=breadcrumb-page]]:font-bold [&_[data-slot=breadcrumb-page]]:text-inherit [&_a]:underline [&_a]:decoration-wavy [&_a]:decoration-2 [&_a]:underline-offset-4 [&_a]:decoration-transparent [&_a]:transition-[color,text-decoration-color] [&_a]:duration-300 [&_a:hover]:decoration-current">
          {/* Home */}
          <BreadcrumbItem>
            {isCurrent("/") ? (
              <BreadcrumbPage>{site_config.homeLabel}</BreadcrumbPage>
            ) : (
              <BreadcrumbLink href="/">{site_config.homeLabel}</BreadcrumbLink>
            )}
          </BreadcrumbItem>

          {site_config.navigationItems &&
            site_config.navigationItems.map((item) => (
              <>
                <BreadcrumbSeparator>•</BreadcrumbSeparator>
                <BreadcrumbItem>
                  {pathname.startsWith(`/${item}`) ? (
                    <BreadcrumbPage>{labelOf(item)}</BreadcrumbPage>
                  ) : (
                    <BreadcrumbLink href={`/${item}`}>{labelOf(item)}</BreadcrumbLink>
                  )}
                </BreadcrumbItem>
              </>
            ))}
        </BreadcrumbList>
      </Breadcrumb>
    </>
  )
}
