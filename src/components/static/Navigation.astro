---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import site_config from "@/site-config.json";

const { pathname } = Astro.props;
const isCurrent = (href: string) => pathname === href;

// 导航显示名可用 navigationLabels 覆盖（键 = 路由名，值 = 显示文案），路由地址本身不变
const labels = (site_config.navigationLabels ?? {}) as Record<string, string>;
const labelOf = (item: string) => labels[item] ?? item;
---

{
  site_config.bNavigation && (
    <>
      <Breadcrumb className="select-none nav-breadcrumb">
        {/* 字号/字重/字距/大写对齐参考站；末尾变体用于压掉 BreadcrumbPage 里硬编码的 font-normal */}
        <BreadcrumbList className="text-[0.72rem] font-bold tracking-[0.16em] uppercase [&_[data-slot=breadcrumb-page]]:font-bold">
          {/* Home */}
          <BreadcrumbItem>
            {isCurrent("/") ? (
              <BreadcrumbPage>{site_config.homeLabel}</BreadcrumbPage>
            ) : (
              <BreadcrumbLink href="/">{site_config.homeLabel}</BreadcrumbLink>
            )}
          </BreadcrumbItem>

          {site_config.navigationItems &&
            site_config.navigationItems.map((item) => (
              <>
                <BreadcrumbSeparator>•</BreadcrumbSeparator>
                <BreadcrumbItem>
                  {pathname.startsWith(`/${item}`) ? (
                    <BreadcrumbPage>{labelOf(item)}</BreadcrumbPage>
                  ) : (
                    <BreadcrumbLink href={`/${item}`}>{labelOf(item)}</BreadcrumbLink>
                  )}
                </BreadcrumbItem>
              </>
            ))}
        </BreadcrumbList>
      </Breadcrumb>
    </>
  )
}
