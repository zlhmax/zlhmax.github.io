---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import { RiHome5Fill, RiArticleFill } from "@remixicon/react";
import { NavLinkIcon } from "./NavLinkIcon";
import site_config from "@/site-config.json";

const { pathname } = Astro.props;
const isCurrent = (href: string) => pathname === href;

// 导航项小图标（2026-10-02：按 Eddy 要求，参照参考站 Kanade-Astro 在每项前加图标）
const navIcons: Record<string, any> = {
  portfolio: NavLinkIcon, // Travel → 参考站「友链」同款图标（MingCute link-3-line 原样复刻）
  blog: RiArticleFill, // Blog
};
const iconOf = (item: string) => navIcons[item] ?? null;
// 图标类：尺寸与防压缩交给 flex 居中（父级已 inline-flex items-center gap-1）；
// 再上移 1px 修正「文字盒含下降部导致的视觉中心偏高」（初版 0.5px → Eddy 要求再移 0.5px）
const ICON_CLS = "size-3 shrink-0 -translate-y-[1px]";

// 导航显示名可用 navigationLabels 覆盖（键 = 路由名，值 = 显示文案），路由地址本身不变
const labels = (site_config.navigationLabels ?? {}) as Record<string, string>;
const labelOf = (item: string) => labels[item] ?? item;
---

{
  site_config.bNavigation && (
    <>
      <Breadcrumb className="select-none nav-breadcrumb">
        {/* 字号/字重/字距/大写对齐参考站；变体1&2 压掉 BreadcrumbPage 自带的 font-normal 与 text-foreground/90，
            让「当前页（无链接）」与「有链接项」颜色一致；变体3 起 = 超链悬停下划线：
              常态画一条透明直线（decoration-transparent，不占布局）→ 悬停显色 hover:decoration-current，
              配 transition-[color,text-decoration-color] 得到淡入；离字 6px(underline-offset-6)、线宽 2px(decoration-2)、实线(默认 solid) */}
        <BreadcrumbList className="text-[10.2px] font-bold tracking-[0.16em] uppercase [&_[data-slot=breadcrumb-page]]:font-bold [&_[data-slot=breadcrumb-page]]:text-inherit [&_a]:underline [&_a]:decoration-2 [&_a]:underline-offset-6 [&_a]:decoration-transparent [&_a]:transition-[color,text-decoration-color] [&_a]:duration-300 [&_a:hover]:decoration-current [&_a]:inline-flex [&_a]:items-center [&_a]:gap-1 [&_[data-slot=breadcrumb-page]]:inline-flex [&_[data-slot=breadcrumb-page]]:items-center [&_[data-slot=breadcrumb-page]]:gap-1">
          {/* Home */}
          <BreadcrumbItem>
            {isCurrent("/") ? (
              <BreadcrumbPage><RiHome5Fill className={ICON_CLS} />{site_config.homeLabel}</BreadcrumbPage>
            ) : (
              <BreadcrumbLink href="/"><RiHome5Fill className={ICON_CLS} />{site_config.homeLabel}</BreadcrumbLink>
            )}
          </BreadcrumbItem>

          {site_config.navigationItems &&
            site_config.navigationItems.map((item) => {
              const Icon = iconOf(item);
              return (
                <>
                  <BreadcrumbSeparator>•</BreadcrumbSeparator>
                  <BreadcrumbItem>
                    {pathname.startsWith(`/${item}`) ? (
                      <BreadcrumbPage>{Icon && <Icon className={ICON_CLS} />}{labelOf(item)}</BreadcrumbPage>
                    ) : (
                      <BreadcrumbLink href={`/${item}`}>{Icon && <Icon className={ICON_CLS} />}{labelOf(item)}</BreadcrumbLink>
                    )}
                  </BreadcrumbItem>
                </>
              );
            })}
        </BreadcrumbList>
      </Breadcrumb>
    </>
  )
}
