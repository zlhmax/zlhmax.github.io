---
import { RiCalendar2Line } from "@remixicon/react";
import BackButton from "../static/BackButton.astro";
import ShareButton from "../client/ShareButton.tsx";
import { parse, format } from "date-fns";

const { backUrl, items, compact = false } = Astro.props;

const parsedDate = parse(items.date, "dd-MM-yyyy", new Date());
const formattedDate = format(parsedDate, "MMMM dd, yyyy");
---

<div class="border border-border mt-5 p-6">
    <BackButton url={backUrl} />

    <header class="mt-3 select-none">
        <h1 class="text-3xl font-semibold opacity-90">{items.title}</h1>
        <p class={`${compact ? "text-sm" : "text-base"} leading-10 border-l-2 border-muted-foreground/30 pl-4 text-muted-foreground mt-3`}>{items.description}</p>

        <div class="flex items-center gap-3 mt-3 text-muted-foreground text-[11px]">
            <div class="flex items-center gap-1.5 mr-3">
                <RiCalendar2Line className="size-3" />
                <span>{formattedDate}</span>
            </div>
            <span class="text-[10px] px-2 py-0.5 border border-muted-foreground/30 text-muted-foreground rounded uppercase mr-1">
                {items.category}
            </span>
            <ShareButton client:load />
        </div>

        {
            items.tags && items.tags.length > 0 && (
                <div class="flex gap-2 mt-4 flex-wrap">
                    {items.tags.map((tag: string) => (
                        <span class="text-[11px] px-3 py-1 bg-muted text-muted-foreground rounded">{tag}</span>
                    ))}
                </div>
            )
        }
    </header>
</div>
