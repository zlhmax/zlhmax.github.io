---
import type { portfolioConfig } from "@/lib/types";
import { RiArrowRightUpLine } from "@remixicon/react";

export interface Props {
    item: portfolioConfig;
}

const { item } = Astro.props;
const links = item?.links ?? [];
const introduction = item?.introduction ?? "";
const capabilities = item?.brief?.capabilities ?? [];
const architecture = item?.brief?.architecture ?? [];
const hasCapabilities = capabilities.length > 0;
const hasArchitecture = architecture.length > 0;
---

<section class="border border-border p-6 flex flex-wrap gap-2">
    <input type="radio" name="details-tab" id="dt-intro" class="hidden peer/intro" checked />
    {hasCapabilities && <input type="radio" name="details-tab" id="dt-capabilities" class="hidden peer/cap" />}
    {hasArchitecture && <input type="radio" name="details-tab" id="dt-architecture" class="hidden peer/arch" />}

    <label for="dt-intro" class="inline-flex h-[25.6px] w-auto items-center justify-center rounded-[8px] border border-border bg-background px-4 text-xs font-mono tracking-widest uppercase leading-none text-muted-foreground cursor-pointer select-none transition-all duration-150 hover:-translate-y-0.5 hover:border-[color:var(--link-hover)] hover:text-[color:var(--link-hover)] peer-checked/intro:border-transparent peer-checked/intro:bg-muted peer-checked/intro:text-foreground intro-tab-grad">Introduction</label>
    {
        hasCapabilities && (
            <label for="dt-capabilities" class="inline-flex h-[25.6px] w-auto items-center justify-center rounded-[8px] border border-border bg-background px-4 text-xs font-mono tracking-widest uppercase leading-none text-muted-foreground cursor-pointer select-none transition-all duration-150 hover:-translate-y-0.5 hover:border-[color:var(--link-hover)] hover:text-[color:var(--link-hover)] peer-checked/cap:border-transparent peer-checked/cap:bg-muted peer-checked/cap:text-foreground intro-tab-grad">
                Capabilities
            </label>
        )
    }
    {
        hasArchitecture && (
            <label for="dt-architecture" class="inline-flex h-[25.6px] w-auto items-center justify-center rounded-[8px] border border-border bg-background px-4 text-xs font-mono tracking-widest uppercase leading-none text-muted-foreground cursor-pointer select-none transition-all duration-150 hover:-translate-y-0.5 hover:border-[color:var(--link-hover)] hover:text-[color:var(--link-hover)] peer-checked/arch:border-transparent peer-checked/arch:bg-muted peer-checked/arch:text-foreground intro-tab-grad">
                Architecture
            </label>
        )
    }

    {
        introduction && (
            <div class="w-full hidden peer-checked/intro:block h-auto overflow-y-auto no-scrollbar mt-6">
                <div class="h-full flex items-center px-0 py-6">
                    <p class="text-[16px]/[1.9] text-[color:var(--prose-fg)] whitespace-pre-line max-w-none text-left [font-family:var(--article-text-font)]">{introduction}</p>
                </div>
            </div>
        )
    }

    {
        hasCapabilities && (
            <div class="w-full hidden peer-checked/cap:block h-auto overflow-y-auto no-scrollbar mt-6">
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    {capabilities.map((item) => (
                        <li class="relative p-6 bg-muted/30 hover:bg-background border border-border hover:border-foreground/30 animation group">
                            <span class="absolute top-0 left-0 size-2 bg-background border border-secondary-foreground/60 group-hover:border-0 group-hover:bg-secondary-foreground/60 animation" />
                            <span class="text-base leading-snug text-secondary-foreground/80">{item}</span>
                        </li>
                    ))}
                </ul>
            </div>
        )
    }

    {
        hasArchitecture && (
            <div class="w-full hidden peer-checked/arch:block h-auto overflow-y-auto no-scrollbar mt-6">
                <div class="relative space-y-0">
                    {architecture.map((item) => (
                        <div class="border border-border bg-muted/30 p-6 hover:bg-background hover:border-foreground/30 animation mb-3 last:mb-0">
                            <p class="text-base leading-relaxed text-secondary-foreground/80">{item}</p>
                        </div>
                    ))}
                </div>
            </div>
        )
    }
</section>
