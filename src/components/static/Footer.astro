---
import site_config from "@/site-config.json";
import { getTotalWords, getPostCount, formatWords } from "@/lib/wordcount";

const totalWords = await getTotalWords();
const postCount = await getPostCount();
---

<footer class="mx-auto font-mono antialiased bg-background max-w-4xl text-foreground select-none sticky bottom-0 z-0">
    {/* 2026-10-03 Eddy 要求：页脚整体高度 +50%（原 36px → 54px），且文字上下间隙保持一致
        内容行高 20px + 上下 padding 各 17px = 54px（= 36 × 1.5） */}
    <div class="flex items-center justify-between px-1 py-[17px]">
        <div class="flex items-center gap-4">
            <p class="text-sm text-muted-foreground">
                &copy; {new Date().getFullYear()}
                {site_config.introduction.heading}.cn
            </p>
        </div>
        <div>
            <p class="text-xs text-muted-foreground">
                写下{postCount}篇文章 {formatWords(totalWords)}字
            </p>
        </div>
    </div>
</footer>
