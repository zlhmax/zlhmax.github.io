---
import site_config from "@/site-config.json";
import { getTotalWords, getPostCount, formatWords } from "@/lib/wordcount";

const totalWords = await getTotalWords();
const postCount = await getPostCount();
---

<footer class="font-mono antialiased bg-background text-foreground select-none sticky bottom-0 z-0">
    <div class="flex items-center justify-between px-3 py-2">
        <div class="flex items-center gap-4">
            <p class="text-sm text-muted-foreground">
                &copy; {new Date().getFullYear()}
                {site_config.introduction.heading}.cn
            </p>
        </div>
        <div>
            <p class="text-xs text-muted-foreground">
                写下{postCount}篇文章 {formatWords(totalWords)}字
            </p>
        </div>
    </div>
</footer>
